{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "es2024",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "paths": {
      "@server/*": ["./src/*"],
      "natural-orderby": ["./src/sort"],
      "@syuchan1005/book-reader-graphql": ["./generated/GQLResolvers.ts"]
    }
  },
  "include": ["src/*"],
  "exclude": ["node_modules", "generated/GQLResolvers.ts"]
}
